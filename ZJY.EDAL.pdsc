<?xml version="1.0" encoding="utf-8"?>

<package schemaVersion="1.7.28"
         xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
         xs:noNamespaceSchemaLocation="https://raw.githubusercontent.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/main/schema/PACK.xsd">

    <vendor>ZJY</vendor>
    <name>EDAL</name>
    <description>
        Embedded Device Abstraction Layer.
    </description>
    <url>https://github.com/ZJY-Nerd/EDAL/</url>
    <supportContact>zhujinyuan818@gmail.com</supportContact>
    <license>LICENSE</license>

    <!-- ================================================================== -->
    <!--  Keywords                                                          -->
    <!-- ================================================================== -->
    <keywords>
        <keyword>EDAL</keyword>
    </keywords>

    <!-- ================================================================== -->
    <!--  Release History                                                   -->
    <!-- ================================================================== -->
    <releases>
        <release version="1.0.0" date="2026-11-13">
            Revision v1.0.0
            - Initial Version
        </release>
    </releases>

    <!-- ================================================================== -->
    <!--  Conditions                                                        -->
    <!-- ================================================================== -->
    <!-- <conditions>
        <condition id="EDAL Driver">
            <description>Requires GUI_LVGL_Wrapper Core component</description>
            <require Cclass="EDAL" Cgroup="Core"/>
        </condition>

        <condition id="EDAL Device">
            <description>Requires GUI_LVGL_Wrapper Core component</description>
            <require Cclass="EDAL" Cgroup="Core"/>
        </condition>

    </conditions> -->

    <!-- ================================================================== -->
    <!--  Components                                                        -->
    <!-- ================================================================== -->
    <components>
        <!-- 
            Driver Component.
            INCLUDE: GPIO、I2C、SPI.
         -->

        <!-- GPIO Driver -->
        <component Cclass="EDAL" Cgroup="01_DRIVER" Csub="GPIO" Cversion="1.0.0">
            <description>
                EDAL GPIO driver.
            </description>

            <files>
                <file category="header" version="1.0.0" name="EDAL_Common.h"/>
                <file category="header" version="1.0.0" name="Driver/Include/Driver_GPIO.h"/>
                <file category="sourceC" attr="config" version="1.0.0" name="Driver/DriverTemplates/Driver_GPIO.c"/>
            </files>

            <Pre_Include_Global_h>
#define __RTE_EDAL_DRIVER_GPIO__
            </Pre_Include_Global_h>

            <RTE_Components_h>
#define __RTE_EDAL_DRIVER_GPIO__
            </RTE_Components_h>
        </component>

        <!-- I2C Driver -->
        <component Cclass="EDAL" Cgroup="01_DRIVER" Csub="I2C" Cversion="1.0.0">
            <description>
                EDAL I2C driver.
            </description>

            <files>
                <file category="header" version="1.0.0" name="EDAL_Common.h"/>
                <file category="header" version="1.0.0" name="Driver/Include/Driver_I2C.h"/>
                <file category="sourceC" attr="config" version="1.0.0" name="Driver/DriverTemplates/Driver_I2C.c"/>
            </files>

            <Pre_Include_Global_h>
#define __RTE_EDAL_DRIVER_I2C__
            </Pre_Include_Global_h>

            <RTE_Components_h>
#define __RTE_EDAL_DRIVER_I2C__
            </RTE_Components_h>
        </component>

        <!-- SPI Driver -->
        <component Cclass="EDAL" Cgroup="01_DRIVER" Csub="SPI" Cversion="1.0.0">
            <description>
                EDAL SPI driver.
            </description>

            <files>
                <file category="header" version="1.0.0" name="EDAL_Common.h"/>
                <file category="header" version="1.0.0" name="Driver/Include/Driver_SPI.h"/>
                <file category="sourceC" attr="config" version="1.0.0" name="Driver/DriverTemplates/Driver_SPI.c"/>
            </files>

            <Pre_Include_Global_h>
#define __RTE_EDAL_DRIVER_SPI__
            </Pre_Include_Global_h>

            <RTE_Components_h>
#define __RTE_EDAL_DRIVER_SPI__
            </RTE_Components_h>
        </component>



        <!-- 
            Device Component.
            INCLUDE: BEEP、KEY、LCD.
         -->

        <!-- Beep Device -->
        <component Cclass="EDAL" Cgroup="02_DEVICE" Csub="BEEP" Cversion="1.0.0">
            <description>
                EDAL BEEP device.
            </description>

            <files>
                <file category="header" version="1.0.0" name="EDAL_Common.h"/>
                <file category="header" version="1.0.0" name="Device/Include/Device_BEEP.h"/>
                <file category="sourceC" attr="config" version="1.0.0" name="Device/DeviceTemplates/Device_BEEP.c"/>
            </files>

            <Pre_Include_Global_h>
#define __RTE_EDAL_DEVICE_BEEP__
            </Pre_Include_Global_h>

            <RTE_Components_h>
#define __RTE_EDAL_DEVICE_BEEP__
            </RTE_Components_h>
        </component>

        <!-- Key Device -->
        <component Cclass="EDAL" Cgroup="02_DEVICE" Csub="KEY" Cversion="1.0.0">
            <description>
                EDAL KEY device.
            </description>

            <files>
                <file category="header" version="1.0.0" name="EDAL_Common.h"/>
                <file category="header" version="1.0.0" name="Device/Include/Device_KEY.h"/>
                <file category="sourceC" attr="config" version="1.0.0" name="Device/DeviceTemplates/Device_KEY.c"/>
            </files>

            <Pre_Include_Global_h>
#define __RTE_EDAL_DEVICE_KEY__
            </Pre_Include_Global_h>

            <RTE_Components_h>
#define __RTE_EDAL_DEVICE_KEY__
            </RTE_Components_h>
        </component>

        <!-- Lcd Device -->
        <component Cclass="EDAL" Cgroup="02_DEVICE" Csub="LCD" Cvariant="ILI9341" Cversion="1.0.0">
            <description>
                EDAL LCD ILI9341 device.
            </description>

            <files>
                <file category="header" version="1.0.0" name="EDAL_Common.h"/>
                <file category="header" version="1.0.0" name="Device/Include/Device_LCD.h"/>

                <file category="header"  attr="config" version="1.0.0" name="Device/Display/Device_LCD_Generic.h"/>
                <file category="sourceC" attr="config" version="1.0.0" name="Device/Display/Device_LCD_ILI9341.c"/>

                <!-- <file category="sourceC" attr="config" version="1.0.0" name="Device/DeviceTemplates/Device_LCD.c"/> -->
            </files>

            <Pre_Include_Global_h>
#define __RTE_EDAL_DEVICE_LCD_ILI9341__
            </Pre_Include_Global_h>

            <RTE_Components_h>
#define __RTE_EDAL_DEVICE_LCD_ILI9341__
            </RTE_Components_h>
        </component>


        <component Cclass="EDAL" Cgroup="02_DEVICE" Csub="LCD" Cvariant="ST7789" Cversion="1.0.0">
            <description>
                EDAL LCD ST7789 device.
            </description>

            <files>
                <file category="header" version="1.0.0" name="EDAL_Common.h"/>
                <file category="header" version="1.0.0" name="Device/Include/Device_LCD.h"/>

                <file category="header"  attr="config" version="1.0.0" name="Device/Display/Device_LCD_Generic.h"/>
                <file category="sourceC" attr="config" version="1.0.0" name="Device/Display/Device_LCD_ST7789.c"/>

                <!-- <file category="sourceC" attr="config" version="1.0.0" name="Device/DeviceTemplates/Device_LCD.c"/> -->
            </files>

            <Pre_Include_Global_h>
#define __RTE_EDAL_DEVICE_LCD_ST7789__
            </Pre_Include_Global_h>

            <RTE_Components_h>
#define __RTE_EDAL_DEVICE_LCD_ST7789__
            </RTE_Components_h>
        </component>


        <component Cclass="EDAL" Cgroup="02_DEVICE" Csub="LCD" Cvariant="ST7796" Cversion="1.0.0">
            <description>
                EDAL LCD ST7796 device.
            </description>

            <files>
                <file category="header" version="1.0.0" name="EDAL_Common.h"/>
                <file category="header" version="1.0.0" name="Device/Include/Device_LCD.h"/>

                <file category="header"  attr="config" version="1.0.0" name="Device/Display/Device_LCD_Generic.h"/>
                <file category="sourceC" attr="config" version="1.0.0" name="Device/Display/Device_LCD_ST7796.c"/>

                <!-- <file category="sourceC" attr="config" version="1.0.0" name="Device/DeviceTemplates/Device_LCD.c"/> -->
            </files>

            <Pre_Include_Global_h>
#define __RTE_EDAL_DEVICE_LCD_ST7796__
            </Pre_Include_Global_h>

            <RTE_Components_h>
#define __RTE_EDAL_DEVICE_LCD_ST7796__
            </RTE_Components_h>
        </component>


    </components>

</package>
